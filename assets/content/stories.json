        "voice_en": "assets/audio/en/stories/kido_mangoes_4.m4a",
        "voice_hi": "assets/audio/hi/stories/kido_mangoes_4.m4a"
      },
      {
        "image": "assets/images/stories/kido_mangoes_5.webp",
        "text_en": "Everyone was happy. Sharing is caring!",
        "text_hi": "सब खुश हो गए। बाँटने में ही खुशी है!",
        "voice_en": "assets/audio/en/stories/kido_mangoes_5.m4a",
        "voice_hi": "assets/audio/hi/stories/kido_mangoes_5.m4a"
      }
    ]
  },
  {
    "id": "little_seed",
    "levels": [
      "baby",
      "nursery",
      "lkg",
      "ukg"
    ],
    "title_en": "The Little Seed",
    "title_hi": "छोटा सा बीज",
    "cover": "assets/images/stories/little_seed_cover.webp",
    "voice_title_en": "assets/audio/en/stories/little_seed_title.m4a",
    "voice_title_hi": "assets/audio/hi/stories/little_seed_title.m4a",
    "pages": [
      {
        "image": "assets/images/stories/little_seed_1.webp",
        "text_en": "A tiny seed was sleeping in the soil.",
        "text_hi": "मिट्टी में एक छोटा सा बीज सो रहा था।",
        "voice_en": "assets/audio/en/stories/little_seed_1.m4a",
        "voice_hi": "assets/audio/hi/stories/little_seed_1.m4a"
      },
      {
        "image": "assets/images/stories/little_seed_2.webp",
        "text_en": "The rain said, drink, little seed! Pitter patter!",
        "text_hi": "बारिश बोली, पानी पियो, छोटे बीज! टप टप!",
        "voice_en": "assets/audio/en/stories/little_seed_2.m4a",
        "voice_hi": "assets/audio/hi/stories/little_seed_2.m4a"
      },
      {
        "image": "assets/images/stories/little_seed_3.webp",
        "text_en": "The sun said, grow, little seed! And a green shoot came up.",
        "text_hi": "सूरज बोला, बड़े हो जाओ, छोटे बीज! और एक हरा पौधा निकल आया।",
        "voice_en": "assets/audio/en/stories/little_seed_3.m4a",
        "voice_hi": "assets/audio/hi/stories/little_seed_3.m4a"
