    "pages": [
      {
        "image": "assets/images/stories/kido_sneeze_1.webp",
        "text_en": "Kido the little elephant was smelling the flowers.",
        "text_hi": "छोटा हाथी किडो फूल सूँघ रहा था।",
        "voice_en": "assets/audio/en/stories/kido_sneeze_1.m4a",
        "voice_hi": "assets/audio/hi/stories/kido_sneeze_1.m4a"
      },
      {
        "image": "assets/images/stories/kido_sneeze_2.webp",
        "text_en": "His trunk began to tickle. Aaa... aaa...",
        "text_hi": "उसकी सूँड में गुदगुदी होने लगी। आ... आ...",
        "voice_en": "assets/audio/en/stories/kido_sneeze_2.m4a",
        "voice_hi": "assets/audio/hi/stories/kido_sneeze_2.m4a"
      },
      {
        "image": "assets/images/stories/kido_sneeze_3.webp",
        "text_en": "AAA-CHOO! Flowers flew up into the sky!",
        "text_hi": "आ-छू! फूल उड़कर आसमान में चले गए!",
        "voice_en": "assets/audio/en/stories/kido_sneeze_3.m4a",
        "voice_hi": "assets/audio/hi/stories/kido_sneeze_3.m4a"
      },
      {
        "image": "assets/images/stories/kido_sneeze_4.webp",
        "text_en": "His friends laughed and laughed. Ha ha ha!",
        "text_hi": "उसके दोस्त खूब हँसे। हा हा हा!",
        "voice_en": "assets/audio/en/stories/kido_sneeze_4.m4a",
        "voice_hi": "assets/audio/hi/stories/kido_sneeze_4.m4a"
      },
      {
        "image": "assets/images/stories/kido_sneeze_5.webp",
        "text_en": "Kido laughed too. What a funny sneeze!",
        "text_hi": "किडो भी हँसने लगा। कितनी मज़ेदार छींक थी!",
        "voice_en": "assets/audio/en/stories/kido_sneeze_5.m4a",
        "voice_hi": "assets/audio/hi/stories/kido_sneeze_5.m4a"
      }
    ]
  },
  {
