    "voice_title_en": "assets/audio/en/stories/kido_mangoes_title.m4a",
    "voice_title_hi": "assets/audio/hi/stories/kido_mangoes_title.m4a",
    "pages": [
      {
        "image": "assets/images/stories/kido_mangoes_1.webp",
        "text_en": "Kido found lots of sweet mangoes.",
        "text_hi": "किडो को बहुत सारे मीठे आम मिले।",
        "voice_en": "assets/audio/en/stories/kido_mangoes_1.m4a",
        "voice_hi": "assets/audio/hi/stories/kido_mangoes_1.m4a"
      },
      {
        "image": "assets/images/stories/kido_mangoes_2.webp",
        "text_en": "His friend the monkey looked hungry.",
        "text_hi": "उसका दोस्त बंदर भूखा लग रहा था।",
        "voice_en": "assets/audio/en/stories/kido_mangoes_2.m4a",
        "voice_hi": "assets/audio/hi/stories/kido_mangoes_2.m4a"
      },
      {
        "image": "assets/images/stories/kido_mangoes_3.webp",
        "text_en": "Kido gave him a mango. Here you go, friend!",
        "text_hi": "किडो ने उसे एक आम दिया। यह लो, दोस्त!",
        "voice_en": "assets/audio/en/stories/kido_mangoes_3.m4a",
        "voice_hi": "assets/audio/hi/stories/kido_mangoes_3.m4a"
      },
      {
        "image": "assets/images/stories/kido_mangoes_4.webp",
        "text_en": "Then he shared with the rabbit, the bear and the parrot too.",
